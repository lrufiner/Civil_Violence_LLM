# Copiar este archivo a ".env" y completar con tus credenciales reales.
# NUNCA commitear el archivo ".env" con claves reales al repositorio.

# --- OpenAI (usado si DECISION_ENGINE_CONFIG usa provider="openai") ---
OPENAI_API_KEY=

# --- Anthropic / Claude (usado si provider="anthropic") ---
ANTHROPIC_API_KEY=

# --- TypeSafe AI / Jev (usado si DECISION_ENGINE_CONFIG kind="jev") ---
TYPESAFE_API_KEY=

# --- Ollama local (opcional, por defecto usa http://localhost:11434) ---
OLLAMA_BASE_URL=http://localhost:11434
